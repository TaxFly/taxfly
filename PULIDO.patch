+.taxfly-main-nav .ni{display:flex;align-items:center;justify-content:center;line-height:1;}
+.taxfly-main-nav .more-lbl {font:800 10px 'DM Sans',sans-serif;color:inherit;}
+.taxfly-main-nav .more-dots{height:27px;display:flex;gap:3px;align-items:center;}
+.taxfly-main-nav .more-dot{width:3.5px;height:3.5px;border-radius:50%;background:currentColor;}
+.taxfly-main-nav.nav-bar>.btn-nav-more.open,.taxfly-main-nav.nav-bar>.btn-nav-more.is-current{background:var(--primary-dim,rgba(37,99,235,.12));color:var(--primary,#2563eb);}
+.taxfly-main-nav #btnSettings{width:36px!important;height:36px!important;min-width:36px!important;flex:none;margin-left:4px;align-self:center;border-radius:50%;}
+.taxfly-main-nav .nav-dropdown{position:absolute;top:calc(100% + 10px);right:0;width:min(238px,calc(100vw - 40px));padding:6px;border:1.5px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:var(--shadow-lg);z-index:500;display:none;text-transform:none;letter-spacing:normal;}
+.taxfly-main-nav .nav-dropdown.show{display:block;}
+.taxfly-main-nav .dd-item{display:flex;align-items:center;gap:12px;padding:9px 10px;border-radius:12px;text-align:left;text-decoration:none;color:var(--text);}
+.taxfly-main-nav .dd-item:hover,.taxfly-main-nav .dd-item.current{background:var(--primary-dim,rgba(37,99,235,.12));}
+.taxfly-main-nav .dd-icon{display:flex;align-items:center;justify-content:center;width:34px!important;height:34px;flex:none;border-radius:10px;color:var(--tone);background:color-mix(in srgb,var(--tone) 13%,transparent);}
+.taxfly-main-nav .dd-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
+.taxfly-main-nav .dd-name{font-size:11.5px;font-weight:800;text-transform:uppercase;color:var(--text);}
+.taxfly-main-nav .dd-desc{font-size:10.5px;font-weight:500;line-height:1.25;color:var(--text-sub,var(--muted));margin-top:1px;}
+.taxfly-main-nav [data-tone="cyan"]{--tone:#06b6d4}.taxfly-main-nav [data-tone="violet"]{--tone:#8b5cf6}.taxfly-main-nav [data-tone="red"]{--tone:#ef4444}.taxfly-main-nav [data-tone="amber"]{--tone:#f59e0b}.taxfly-main-nav [data-tone="indigo"]{--tone:#6366f1}
