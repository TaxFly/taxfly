+.taxfly-main-nav.nav-bar {position:relative;top:auto;display:flex;align-items:center;gap:5px;padding:8px;margin:0 0 16px;width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:var(--shadow);overflow:visible;}
