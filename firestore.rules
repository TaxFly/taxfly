// TaxFly / Maps — Reglas de Firestore (proyecto viajes-db538)
//
// ⚠️ IMPORTANTE — LEÉ ESTO ANTES DE DESPLEGAR:
// Este archivo NO es una copia de lo que ya está corriendo en producción
// (Claude no tiene acceso a la consola de Firebase). Es una reconstrucción
// hecha a partir de TODOS los doc()/collection() que usa el código de este
// repo, para que las reglas vivan versionadas en git en vez de solo en la
// consola. Antes de reemplazar lo que hay hoy:
//   1. Abrí Firebase Console → Firestore Database → Reglas, copiá lo que
//      hay ahí ahora a un archivo aparte (por si hay que volver atrás).
//   2. Pegá ESTE archivo en el simulador de reglas (misma pantalla, pestaña
//      "Regla de prueba" / Playground) y probá al menos:
//        - leer/escribir tu propio usuarios/{tu-uid}/perfiles/{perfil}/gastos
//        - crear un grupo (crearGrupo) y unirte a uno con código
//          (unirseGrupo) — es la parte más delicada, ver comentario abajo.
//   3. Recién ahí: Console → pegar y "Publicar", o `firebase deploy
//      --only firestore:rules` si tenés el proyecto vinculado con la CLI.
//
// Estructura de datos que usa el código (relevada del repo, no inventada):
//   usuarios/{uid}                                    → cuenta
//   usuarios/{uid}/perfiles/{perfilId}                → cada perfil (uno por persona)
//     .../gastos/{id}                                 → Gastos (compras.html)
//     .../actividades/{id}, .../notas/{id}            → Itinerario (itinerario.html)
//     .../orlando/{docId}                              → Maps/Orlando Planning
//     .../misCosas/root/{lista}/{docId}                → Mis cosas de viaje
//   users/{uid}/profiles/{pid}/docs/{docId}           → Pólizas/seguro (tickets.html)
//     .../chunks/{chunkId}                             → PDFs partidos en trozos <1MB
//   grupos/{codigo}                                    → viaje compartido entre cuentas
//
// Nota: tickets.html usa 'users'/'profiles' (inglés) mientras el resto usa
// 'usuarios'/'perfiles' (español) — son DOS árboles distintos en Firestore,
// no un alias del mismo. Lo dejo así en las reglas porque así está en el
// código; si en algún momento se migra tickets.html al árbol en español, hay
// que borrar el bloque de 'users' de acá.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cuenta + todos los perfiles de esa cuenta (Tax, Maps, Mis cosas) ──
    // {document=**} cubre el doc de perfiles/{perfilId} y CUALQUIER
    // subcolección debajo, a cualquier profundidad (gastos, actividades,
    // notas, orlando, misCosas/root/<lista>/...), así no hay que listar cada
    // una a mano ni acordarse de agregar una regla nueva cada vez que se
    // suma una función que crea una subcolección más.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /perfiles/{perfilId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Pólizas de seguro (tickets.html) — árbol aparte, ver nota arriba ──
    match /users/{uid}/profiles/{pid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Grupos (viaje compartido entre varias cuentas) ──
    // ⚠️ REVISAR ESPECIALMENTE ESTA PARTE contra el Playground: es la única
    // sección donde alguien necesita tocar un documento que no es "suyo".
    match /grupos/{codigo} {
      // Lectura abierta a cualquier usuario logueado: unirseGrupo() hace un
      // getDoc() por código ANTES de ser miembro, para chequear que el
      // código existe. El código de 6 caracteres funciona como el secreto
      // (no hay forma de listarlos, solo de leer uno si ya tenés el código).
      allow read: if request.auth != null;

      // Crear: solo si el creador se pone a sí mismo como único miembro
      // inicial (así queda igual que hace crearGrupo() en grupo.html).
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.miembroUids == [request.auth.uid];

      // Actualizar: dos casos —
      //  (a) ya sos miembro → podés tocar cualquier campo (gastos, nombre,
      //      etc., como hace grupo.html todo el tiempo).
      //  (b) todavía no sos miembro → SOLO se permite si el único cambio es
      //      agregarte a vos mismo a miembroUids (eso es unirseGrupo()); no
      //      se puede tocar nada más en el mismo request.
      allow update: if request.auth != null && (
        resource.data.miembroUids.hasAny([request.auth.uid])
        || (
          !resource.data.miembroUids.hasAny([request.auth.uid])
          && request.resource.data.miembroUids.hasAll(resource.data.miembroUids)
          && request.resource.data.miembroUids.hasAny([request.auth.uid])
          && request.resource.data.miembroUids.size() == resource.data.miembroUids.size() + 1
        )
      );

      // Borrar: no lo usa el código actual, lo dejo solo para el creador
      // por si se agrega la función más adelante.
      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
    }

    // Todo lo que no matchea arriba: cerrado por default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
