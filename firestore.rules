// TaxFly / Maps — Reglas de Firestore (proyecto viajes-db538)
//
// ⚠️ IMPORTANTE — LEÉ ESTO ANTES DE DESPLEGAR:
// Este archivo NO es una copia de lo que ya está corriendo en producción
// (Claude no tiene acceso a la consola de Firebase). Es una reconstrucción
// hecha a partir de TODOS los doc()/collection() que usa el código de este
// repo, para que las reglas vivan versionadas en git en vez de solo en la
// consola. Antes de reemplazar lo que hay hoy:
//   1. Abrí Firebase Console → Firestore Database → Reglas, copiá lo que
//      hay ahí ahora a un archivo aparte (por si hay que volver atrás).
//   2. Pegá ESTE archivo en el simulador de reglas (misma pantalla, pestaña
//      "Regla de prueba" / Playground) y probá al menos:
//        - leer/escribir tu propio usuarios/{tu-uid}/perfiles/{perfil}/gastos
//        - crear un grupo (crearGrupo) y unirte a uno con código
//          (unirseGrupo) — es la parte más delicada, ver comentario abajo.
//   3. Recién ahí: Console → pegar y "Publicar", o `firebase deploy
//      --only firestore:rules` si tenés el proyecto vinculado con la CLI.
//
// Estructura de datos que usa el código (relevada del repo, no inventada):
//   usuarios/{uid}                                    → cuenta
//   usuarios/{uid}/perfiles/{perfilId}                → cada perfil (uno por persona)
//     .../gastos/{id}                                 → Gastos (compras.html)
//     .../actividades/{id}, .../notas/{id}            → Itinerario (itinerario.html)
//     .../orlando/{docId}                              → Maps/Orlando Planning
//     .../misCosas/root/{lista}/{docId}                → Mis cosas de viaje
//     .../docs/{docId}                                 → Pólizas/seguro (tickets.html)
//     .../docs/{docId}/chunks/{chunkId}                → PDFs partidos en trozos <1MB
//   grupos/{codigo}                                    → viaje compartido entre cuentas
//
// Migración de documentos: antes tickets.html usaba users/{uid}/profiles/{pid}/docs
// (árbol en inglés). assets/docs-tree.js copia ese contenido al árbol español la
// primera vez que se abre cada perfil. El match de 'users' queda como solo lectura
// y borrado hasta terminar la migración; después hay que eliminarlo.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cuenta + todos los perfiles de esa cuenta (Tax, Maps, Mis cosas) ──
    // {document=**} cubre el doc de perfiles/{perfilId} y CUALQUIER
    // subcolección debajo, a cualquier profundidad (gastos, actividades,
    // notas, orlando, misCosas/root/<lista>/...), así no hay que listar cada
    // una a mano ni acordarse de agregar una regla nueva cada vez que se
    // suma una función que crea una subcolección más.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /perfiles/{perfilId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Árbol viejo de documentos (tickets.html) — SOLO LECTURA Y BORRADO ──
    // Los documentos ahora viven en usuarios/{uid}/perfiles/{pid}/docs. Este bloque
    // queda únicamente para que assets/docs-tree.js pueda copiar lo que quede
    // en el árbol viejo, y para limpiarlo después. Sin `create/update`, un cliente
    // viejo que intente escribir acá falla a la vista en vez de dejar datos huérfanos.
    // Cuando todas las cuentas estén migradas y el árbol viejo borrado: eliminar este bloque.
    match /users/{uid}/profiles/{pid}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Grupos (viaje compartido entre varias cuentas) ──
    // Cambios de seguridad respecto de la versión anterior:
    //  - `get` sigue abierto a cualquier logueado (unirseGrupo() lee por código
    //    antes de ser miembro) pero `list` ya NO: solo devuelve grupos donde
    //    sos miembro (la query de grupo.html usa array-contains, así que sigue
    //    funcionando). Antes, cualquier logueado podía listar todos los códigos.
    //  - Al unirte solo se pueden tocar `miembros` y `miembroUids`
    //    (antes se podía reescribir cualquier campo).
    //  - Un miembro no puede cambiar creadoPor/codigo/createdAt ni sacar a otros
    //    de miembroUids (solo sacarse a sí mismo; el creador puede sacar a cualquiera).
    match /grupos/{codigo} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && resource.data.miembroUids.hasAny([request.auth.uid]);

      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.miembroUids == [request.auth.uid]
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.gastos is list
        && request.resource.data.gastos.size() == 0;

      allow update: if request.auth != null && (
        // (a) ya sos miembro
        (
          resource.data.miembroUids.hasAny([request.auth.uid])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creadoPor', 'codigo', 'createdAt'])
          && request.resource.data.get('gastos', []).size() <= 1000
          && (
            // miembroUids sin cambios
            request.resource.data.miembroUids == resource.data.miembroUids
            // o el creador lo modifica libremente (sin dejarlo vacío)
            || (resource.data.creadoPor == request.auth.uid
                && request.resource.data.miembroUids.hasAny([request.auth.uid]))
            // o un miembro se saca solo a sí mismo
            || (!request.resource.data.miembroUids.hasAny([request.auth.uid])
                && request.resource.data.miembroUids.size() == resource.data.miembroUids.size() - 1
                && resource.data.miembroUids.hasAll(request.resource.data.miembroUids))
          )
        )
        // (b) todavía no sos miembro: solo agregarte a vos mismo
        || (
          !resource.data.miembroUids.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'miembroUids'])
          && request.resource.data.miembroUids.hasAll(resource.data.miembroUids)
          && request.resource.data.miembroUids.hasAny([request.auth.uid])
          && request.resource.data.miembroUids.size() == resource.data.miembroUids.size() + 1
        )
      );

      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
    }

    // Todo lo que no matchea arriba: cerrado por default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
